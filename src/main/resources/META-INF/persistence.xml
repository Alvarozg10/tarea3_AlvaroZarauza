<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             version="2.1">

    <persistence-unit name="objectdb">

        <provider>
            com.objectdb.jpa.Provider
        </provider>

        <class>
            com.luisdbb.tarea3AD2024base.objectdb.Incidencia
        </class>

        <class>
            com.luisdbb.tarea3AD2024base.objectdb.ResolucionIncidencia
        </class>

        <properties>

            <property
                    name="javax.persistence.jdbc.url"
                    value="objectdb://localhost:6136/incidenciasADT.odb"/>

            <property
                    name="javax.persistence.jdbc.user"
                    value="admin"/>

            <property
                    name="javax.persistence.jdbc.password"
                    value="admin"/>

        </properties>

    </persistence-unit>

</persistence>