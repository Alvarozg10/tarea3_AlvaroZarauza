<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.luisdbb.tarea3AD2024base.controller.objectdb.ResolverIncidenciaController"
      stylesheets="@/styles/Styles.css">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <VBox spacing="15"
          alignment="CENTER"
          styleClass="card"
          maxWidth="950">

        <padding>
            <Insets top="20"
                    right="20"
                    bottom="20"
                    left="20"/>
        </padding>

        <Label text="Resolver Incidencias"
               styleClass="title"/>

        <TableView fx:id="incidenciasTable"
                   prefWidth="850"
                   prefHeight="350">

            <columns>

                <TableColumn fx:id="tipoColumn"
                             text="Tipo"
                             prefWidth="160"/>

                <TableColumn fx:id="descripcionColumn"
                             text="Descripción"
                             prefWidth="480"/>

                <TableColumn fx:id="resueltaColumn"
                             text="Resuelta"
                             prefWidth="120"/>

            </columns>

        </TableView>

        <TextArea fx:id="accionesArea"
                  promptText="Acciones realizadas"
                  prefWidth="700"
                  prefHeight="150"
                  wrapText="true"/>

        <HBox spacing="15"
               alignment="CENTER">

            <Button text="Resolver incidencia"
                    onAction="#resolverIncidencia"
                    styleClass="button btn-artista"
                    prefWidth="200"/>

            <Button text="Volver"
                    onAction="#volver"
                    styleClass="button btn-invitado"
                    prefWidth="120"/>

        </HBox>

    </VBox>

</VBox>